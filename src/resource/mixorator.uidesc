<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <bitmaps><bitmap name="AnalysatorMainBg" path="analysator_main_bg.png"/></bitmaps>
  <colors>
    <color name="Background" rgba="#0B1014FF"/><color name="TopBar" rgba="#10171DFF"/><color name="Panel" rgba="#111A20F2"/><color name="PanelRaised" rgba="#17232BEE"/><color name="PanelDark" rgba="#0D151AFF"/><color name="Text" rgba="#F2F4F6FF"/><color name="MutedText" rgba="#A9B1B7FF"/><color name="DimText" rgba="#7E8A93FF"/><color name="Accent" rgba="#69D7C0FF"/><color name="AccentSoft" rgba="#173A38FF"/><color name="Good" rgba="#78D2AAFF"/><color name="Warning" rgba="#D9B66FFF"/>
  </colors>
  <fonts>
    <font name="VerdictFont" font-name="Arial" size="24" bold="true" italic="false"/><font name="SectionFont" font-name="Arial" size="15" bold="true" italic="false"/><font name="HintFont" font-name="Arial" size="11" bold="false" italic="false"/><font name="SmallFont" font-name="Arial" size="10" bold="false" italic="false"/>
  </fonts>
  <gradients>
    <gradient name="ButtonIdle"><color-stop rgba="#1B2730EE" start="0"/><color-stop rgba="#111A20EE" start="1"/></gradient><gradient name="ButtonActive"><color-stop rgba="#28524EFF" start="0"/><color-stop rgba="#173A38FF" start="1"/></gradient><gradient name="ButtonAccent"><color-stop rgba="#28524EFF" start="0"/><color-stop rgba="#173A38FF" start="1"/></gradient>
  </gradients>
  <control-tags>
    <control-tag name="UI.Mix" tag="10001"/><control-tag name="UI.Master" tag="10002"/><control-tag name="UI.Live" tag="10003"/><control-tag name="UI.Final" tag="10004"/><control-tag name="UI.Genre" tag="10005"/><control-tag name="UI.Era" tag="10006"/><control-tag name="UI.Reset" tag="10007"/><control-tag name="UI.Analyze" tag="10008"/><control-tag name="UI.Details" tag="10009"/><control-tag name="UI.Back" tag="10010"/>
  </control-tags>

  <template name="compactView" class="CViewContainer" origin="0, 0" size="650, 440" minSize="650, 440" maxSize="650, 440" transparent="false" background-color="Background" bitmap="AnalysatorMainBg">
    <view class="CViewContainer" mixorator-id="simplePage" origin="0, 0" size="650, 440" transparent="true">
      <view class="CTextLabel" origin="18, 10" size="190, 24" title="A N A L Y S A T O R" font-color="Text" transparent="true"/><view class="CTextLabel" origin="18, 34" size="190, 16" title="Mix &amp; Master Assessment" font-color="MutedText" font="SmallFont" transparent="true"/><view class="CTextLabel" origin="602, 14" size="30, 18" title="DE" font-color="MutedText" text-alignment="center" transparent="true"/>
      <view class="CTextLabel" mixorator-id="overallVerdict" origin="220, 116" size="210, 46" title="N/A" font-color="Good" font="VerdictFont" text-alignment="center" transparent="true"/><view class="CTextLabel" mixorator-id="overallLine1" origin="205, 170" size="240, 22" title="Start playback to begin analysis." font-color="Text" font="HintFont" text-alignment="center" transparent="true"/><view class="CTextLabel" mixorator-id="overallLine2" origin="195, 194" size="260, 22" title="No programme data received yet." font-color="MutedText" font="SmallFont" text-alignment="center" transparent="true"/>
      <view class="CTextLabel" origin="18, 294" size="190, 16" title="MODE" font-color="DimText" font="SmallFont" text-alignment="center" transparent="true"/><view class="CTextButton" control-tag="UI.Mix" origin="18, 316" size="87, 35" title="MIX" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="ButtonIdle" gradient-highlighted="ButtonActive" kick-style="false"/><view class="CTextButton" control-tag="UI.Master" origin="110, 316" size="101, 35" title="MASTER" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="ButtonIdle" gradient-highlighted="ButtonActive" kick-style="false"/>
      <view class="CTextLabel" origin="440, 294" size="190, 16" title="STATE" font-color="DimText" font="SmallFont" text-alignment="center" transparent="true"/><view class="CTextButton" control-tag="UI.Live" origin="438, 316" size="104, 35" title="LIVE" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="ButtonIdle" gradient-highlighted="ButtonActive" kick-style="false"/><view class="CTextButton" control-tag="UI.Final" origin="546, 316" size="86, 35" title="FINAL" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="ButtonIdle" gradient-highlighted="ButtonActive" kick-style="false"/>
      <view class="CTextButton" control-tag="UI.Details" origin="239, 339" size="172, 40" title="DETAILS" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="ButtonAccent" gradient-highlighted="ButtonActive" kick-style="true"/>
      <view class="CTextLabel" origin="110, 397" size="68, 15" title="GENRE" font-color="DimText" font="SmallFont" text-alignment="right" transparent="true"/><view class="COptionMenu" control-tag="UI.Genre" origin="184, 394" size="142, 27" font-color="Text" back-color="PanelRaised" frame-color="AccentSoft" frame-width="1" menu-popup-style="true" text-inset="8, 0"/><view class="CTextLabel" origin="338, 397" size="44, 15" title="ERA" font-color="DimText" font="SmallFont" text-alignment="right" transparent="true"/><view class="COptionMenu" control-tag="UI.Era" origin="388, 394" size="110, 27" font-color="Text" back-color="PanelRaised" frame-color="AccentSoft" frame-width="1" menu-popup-style="true" text-inset="8, 0"/>
    </view>
  </template>

  <template name="detailsView" class="CViewContainer" origin="0, 0" size="1000, 700" minSize="1000, 700" maxSize="1000, 700" transparent="false" background-color="Background">
    <view class="CViewContainer" origin="0, 0" size="1000, 82" transparent="false" background-color="TopBar">
      <view class="CTextLabel" origin="24, 10" size="180, 24" title="A N A L Y S A T O R" font-color="Text"/><view class="CTextLabel" origin="24, 36" size="190, 16" title="Mix &amp; Master Assessment" font-color="MutedText" font="SmallFont"/>
      <view class="CTextButton" control-tag="UI.Mix" origin="238, 16" size="70, 32" title="MIX" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="ButtonIdle" gradient-highlighted="ButtonActive" kick-style="false"/><view class="CTextButton" control-tag="UI.Master" origin="312, 16" size="82, 32" title="MASTER" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="ButtonIdle" gradient-highlighted="ButtonActive" kick-style="false"/><view class="CTextButton" control-tag="UI.Live" origin="414, 16" size="70, 32" title="LIVE" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="ButtonIdle" gradient-highlighted="ButtonActive" kick-style="false"/><view class="CTextButton" control-tag="UI.Final" origin="488, 16" size="70, 32" title="FINAL" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="ButtonIdle" gradient-highlighted="ButtonActive" kick-style="false"/>
      <view class="CTextLabel" origin="580, 7" size="150, 13" title="GENRE" font-color="DimText" font="SmallFont"/><view class="COptionMenu" control-tag="UI.Genre" origin="580, 24" size="174, 30" font-color="Text" back-color="PanelRaised" frame-color="AccentSoft" frame-width="1" menu-popup-style="true" text-inset="8, 0"/><view class="CTextLabel" origin="770, 7" size="110, 13" title="ERA" font-color="DimText" font="SmallFont"/><view class="COptionMenu" control-tag="UI.Era" origin="770, 24" size="116, 30" font-color="Text" back-color="PanelRaised" frame-color="AccentSoft" frame-width="1" menu-popup-style="true" text-inset="8, 0"/><view class="CTextLabel" origin="930, 22" size="36, 18" title="DE" font-color="MutedText" text-alignment="center"/>
    </view>

    <view class="CViewContainer" mixorator-id="detailsPage" origin="24, 100" size="952, 574" transparent="false" background-color="Panel">
      <view class="CTextLabel" origin="22, 16" size="300, 24" title="DETAILED ANALYSIS" font-color="Text" font="SectionFont"/><view class="CTextLabel" origin="22, 41" size="470, 16" title="Technical integrity, style context and delivery measurements" font-color="DimText" font="SmallFont"/><view class="CTextButton" control-tag="UI.Back" origin="798, 14" size="132, 34" title="BACK" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="ButtonIdle" gradient-highlighted="ButtonActive" kick-style="true"/>

      <view class="CViewContainer" origin="22, 76" size="432, 352" transparent="false" background-color="PanelDark">
        <view class="CTextLabel" origin="18, 14" size="396, 20" title="ASSESSMENT" font-color="DimText" font="SmallFont" text-alignment="center"/>
        <view class="CTextLabel" origin="18, 54" size="190, 24" title="TECHNICAL QUALITY" font-color="MutedText"/><view class="CTextLabel" mixorator-id="technicalVerdict" origin="222, 52" size="190, 28" title="N/A" font-color="Good" text-alignment="right"/>
        <view class="CTextLabel" origin="18, 106" size="190, 24" title="STYLE MATCH" font-color="MutedText"/><view class="CTextLabel" mixorator-id="styleVerdict" origin="222, 104" size="190, 28" title="N/A" font-color="Good" text-alignment="right"/>
        <view class="CTextLabel" origin="18, 158" size="190, 24" title="PCM / WAV" font-color="MutedText"/><view class="CTextLabel" mixorator-id="pcmVerdict" origin="222, 156" size="190, 28" title="N/A" font-color="Good" text-alignment="right"/>
        <view class="CTextLabel" origin="18, 210" size="190, 24" title="STREAMING" font-color="MutedText"/><view class="CTextLabel" mixorator-id="streamingVerdict" origin="222, 208" size="190, 28" title="N/A" font-color="Good" text-alignment="right"/>
        <view class="CTextLabel" origin="18, 276" size="396, 18" title="ANALYSIS STATE" font-color="DimText" font="SmallFont" text-alignment="center"/><view class="CTextLabel" mixorator-id="stateLabel" origin="18, 300" size="396, 32" title="WAITING FOR AUDIO" font-color="Warning" text-alignment="center"/>
      </view>

      <view class="CViewContainer" origin="474, 76" size="456, 352" transparent="false" background-color="PanelDark">
        <view class="CTextLabel" origin="18, 14" size="420, 20" title="MEASUREMENTS" font-color="DimText" font="SmallFont" text-alignment="center"/>
        <view class="CTextLabel" origin="20, 54" size="210, 24" title="INTEGRATED" font-color="MutedText"/><view class="CTextLabel" mixorator-id="integratedValue" origin="248, 52" size="188, 28" title="--" font-color="Text" text-alignment="right"/>
        <view class="CTextLabel" origin="20, 100" size="210, 24" title="TRUE PEAK" font-color="MutedText"/><view class="CTextLabel" mixorator-id="truePeakValue" origin="248, 98" size="188, 28" title="--" font-color="Text" text-alignment="right"/>
        <view class="CTextLabel" origin="20, 146" size="210, 24" title="PLR" font-color="MutedText"/><view class="CTextLabel" mixorator-id="plrValue" origin="248, 144" size="188, 28" title="--" font-color="Text" text-alignment="right"/>
        <view class="CTextLabel" origin="20, 192" size="210, 24" title="LRA" font-color="MutedText"/><view class="CTextLabel" mixorator-id="lraValue" origin="248, 190" size="188, 28" title="--" font-color="Text" text-alignment="right"/>
        <view class="CTextLabel" origin="20, 238" size="210, 24" title="CORRELATION" font-color="MutedText"/><view class="CTextLabel" mixorator-id="correlationValue" origin="248, 236" size="188, 28" title="--" font-color="Text" text-alignment="right"/>
        <view class="CTextLabel" origin="20, 284" size="210, 24" title="MONO" font-color="MutedText"/><view class="CTextLabel" mixorator-id="monoValue" origin="248, 282" size="188, 28" title="--" font-color="Text" text-alignment="right"/>
      </view>

      <view class="CTextLabel" origin="24, 458" size="540, 20" title="Play the full programme for a definitive FINAL assessment." font-color="MutedText"/><view class="CTextLabel" origin="24, 484" size="540, 20" title="LIVE values are provisional and may change." font-color="DimText"/>
      <view class="CTextButton" control-tag="UI.Reset" origin="622, 456" size="142, 52" title="RESET" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="ButtonIdle" gradient-highlighted="ButtonActive" kick-style="true"/><view class="CTextButton" control-tag="UI.Analyze" origin="778, 456" size="152, 52" title="ANALYZE" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="ButtonAccent" gradient-highlighted="ButtonActive" kick-style="true"/>
      <view class="CTextLabel" origin="24, 536" size="904, 16" title="Transparent assessment - audio is never altered" font-color="DimText" font="SmallFont" text-alignment="center"/>
    </view>
  </template>
</vstgui-ui-description>