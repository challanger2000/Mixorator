<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <bitmaps><bitmap name="AnalysatorMainBg" path="analysator_main_bg.png"/><bitmap name="AnalysatorDetailsBg" path="analysator_details_bg.png"/></bitmaps>
  <colors>
    <color name="Background" rgba="#0B1014FF"/><color name="TopBar" rgba="#10171DFF"/><color name="Panel" rgba="#111A20F2"/><color name="PanelRaised" rgba="#17232BEE"/><color name="PanelDark" rgba="#0D151AFF"/><color name="Text" rgba="#F2F4F6FF"/><color name="MutedText" rgba="#A9B1B7FF"/><color name="DimText" rgba="#7E8A93FF"/><color name="Accent" rgba="#69D7C0FF"/><color name="AccentSoft" rgba="#173A38FF"/><color name="Good" rgba="#78D2AAFF"/><color name="Warning" rgba="#D9B66FFF"/>
  </colors>
  <fonts>
    <font name="VerdictFont" font-name="Arial" size="24" bold="true" italic="false"/><font name="DetailVerdictFont" font-name="Arial" size="18" bold="true" italic="false"/><font name="MetricFont" font-name="Arial" size="16" bold="true" italic="false"/><font name="StatusFont" font-name="Arial" size="14" bold="true" italic="false"/><font name="SectionFont" font-name="Arial" size="15" bold="true" italic="false"/><font name="HintFont" font-name="Arial" size="11" bold="false" italic="false"/><font name="SmallFont" font-name="Arial" size="10" bold="false" italic="false"/>
  </fonts>
  <gradients>
    <gradient name="ButtonIdle"><color-stop rgba="#1B2730EE" start="0"/><color-stop rgba="#111A20EE" start="1"/></gradient><gradient name="ButtonActive"><color-stop rgba="#28524EFF" start="0"/><color-stop rgba="#173A38FF" start="1"/></gradient><gradient name="ButtonAccent"><color-stop rgba="#28524EFF" start="0"/><color-stop rgba="#173A38FF" start="1"/></gradient>
    <gradient name="HardwareIdle"><color-stop rgba="#101A20B8" start="0"/><color-stop rgba="#071015B8" start="1"/></gradient><gradient name="HardwareActive"><color-stop rgba="#2A5D57D8" start="0"/><color-stop rgba="#173D3AD8" start="1"/></gradient><gradient name="HardwareAction"><color-stop rgba="#27625CD8" start="0"/><color-stop rgba="#123D39D8" start="1"/></gradient>
  </gradients>
  <control-tags>
    <control-tag name="UI.Mix" tag="10001"/><control-tag name="UI.Master" tag="10002"/><control-tag name="UI.Live" tag="10003"/><control-tag name="UI.Final" tag="10004"/><control-tag name="UI.Genre" tag="10005"/><control-tag name="UI.Era" tag="10006"/><control-tag name="UI.Reset" tag="10007"/><control-tag name="UI.Analyze" tag="10008"/><control-tag name="UI.Details" tag="10009"/><control-tag name="UI.Back" tag="10010"/>
  </control-tags>

  <template name="compactView" class="CViewContainer" origin="0, 0" size="650, 440" minSize="650, 440" maxSize="650, 440" transparent="false" background-color="Background" bitmap="AnalysatorMainBg">
    <view class="CViewContainer" mixorator-id="simplePage" origin="0, 0" size="650, 440" transparent="true">
      <view class="CTextLabel" origin="18, 10" size="190, 24" title="A N A L Y S A T O R" font-color="Text" transparent="true"/><view class="CTextLabel" origin="18, 34" size="190, 16" title="Mix &amp; Master Assessment" font-color="MutedText" font="SmallFont" transparent="true"/><view class="CTextLabel" origin="602, 14" size="30, 18" title="DE" font-color="MutedText" text-alignment="center" transparent="true"/>
      <view class="CTextLabel" mixorator-id="overallVerdict" origin="220, 116" size="210, 46" title="N/A" font-color="Good" font="VerdictFont" text-alignment="center" transparent="true"/><view class="CTextLabel" mixorator-id="overallLine1" origin="205, 170" size="240, 22" title="Start playback to analyze" font-color="Text" font="HintFont" text-alignment="center" transparent="true"/><view class="CTextLabel" mixorator-id="overallLine2" origin="195, 194" size="260, 22" title="Waiting for programme data" font-color="MutedText" font="SmallFont" text-alignment="center" transparent="true"/>
      <view class="CTextLabel" origin="18, 294" size="190, 16" title="MODE" font-color="DimText" font="SmallFont" text-alignment="center" transparent="true"/><view class="CTextButton" control-tag="UI.Mix" origin="18, 316" size="87, 35" title="MIX" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="ButtonIdle" gradient-highlighted="ButtonActive" kick-style="false"/><view class="CTextButton" control-tag="UI.Master" origin="110, 316" size="101, 35" title="MASTER" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="ButtonIdle" gradient-highlighted="ButtonActive" kick-style="false"/>
      <view class="CTextLabel" origin="440, 294" size="190, 16" title="STATE" font-color="DimText" font="SmallFont" text-alignment="center" transparent="true"/><view class="CTextButton" control-tag="UI.Live" origin="438, 316" size="104, 35" title="LIVE" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="ButtonIdle" gradient-highlighted="ButtonActive" kick-style="false"/><view class="CTextButton" control-tag="UI.Final" origin="546, 316" size="86, 35" title="FINAL" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="ButtonIdle" gradient-highlighted="ButtonActive" kick-style="false"/>
      <view class="CTextButton" control-tag="UI.Details" origin="239, 339" size="172, 40" title="DETAILS" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="ButtonAccent" gradient-highlighted="ButtonActive" kick-style="true"/>
      <view class="CTextLabel" origin="110, 397" size="68, 15" title="GENRE" font-color="DimText" font="SmallFont" text-alignment="right" transparent="true"/><view class="COptionMenu" control-tag="UI.Genre" origin="184, 394" size="142, 27" font-color="Text" back-color="PanelRaised" frame-color="AccentSoft" frame-width="1" menu-popup-style="true" text-inset="8, 0"/><view class="CTextLabel" origin="338, 397" size="44, 15" title="ERA" font-color="DimText" font="SmallFont" text-alignment="right" transparent="true"/><view class="COptionMenu" control-tag="UI.Era" origin="388, 394" size="110, 27" font-color="Text" back-color="PanelRaised" frame-color="AccentSoft" frame-width="1" menu-popup-style="true" text-inset="8, 0"/>
    </view>
  </template>

  <template name="detailsView" class="CViewContainer" origin="0, 0" size="1000, 700" minSize="1000, 700" maxSize="1000, 700" transparent="false" background-color="Background" bitmap="AnalysatorDetailsBg">
    <view class="CViewContainer" mixorator-id="detailsPage" origin="0, 0" size="1000, 700" transparent="true">
      <view class="CTextLabel" origin="42, 26" size="176, 24" title="A N A L Y S A T O R" font-color="Text" transparent="true"/><view class="CTextLabel" origin="44, 48" size="176, 16" title="Mix &amp; Master Assessment" font-color="MutedText" font="SmallFont" transparent="true"/>
      <view class="CTextButton" control-tag="UI.Mix" origin="232, 32" size="76, 40" title="MIX" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="HardwareIdle" gradient-highlighted="HardwareActive" kick-style="false"/><view class="CTextButton" control-tag="UI.Master" origin="322, 32" size="76, 40" title="MASTER" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="HardwareIdle" gradient-highlighted="HardwareActive" kick-style="false"/>
      <view class="CTextButton" control-tag="UI.Live" origin="412, 32" size="76, 40" title="LIVE" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="HardwareIdle" gradient-highlighted="HardwareActive" kick-style="false"/><view class="CTextButton" control-tag="UI.Final" origin="502, 32" size="76, 40" title="FINAL" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="HardwareIdle" gradient-highlighted="HardwareActive" kick-style="false"/>
      <view class="CTextLabel" origin="610, 19" size="126, 14" title="GENRE" font-color="DimText" font="SmallFont" text-alignment="center" transparent="true"/><view class="COptionMenu" control-tag="UI.Genre" origin="621, 40" size="121, 29" font-color="Text" back-color="PanelDark" frame-color="AccentSoft" frame-width="1" menu-popup-style="true" text-inset="8, 0"/><view class="CTextLabel" origin="778, 19" size="104, 14" title="ERA" font-color="DimText" font="SmallFont" text-alignment="center" transparent="true"/><view class="COptionMenu" control-tag="UI.Era" origin="782, 40" size="100, 29" font-color="Text" back-color="PanelDark" frame-color="AccentSoft" frame-width="1" menu-popup-style="true" text-inset="8, 0"/><view class="CTextLabel" origin="923, 38" size="42, 24" title="DE" font-color="MutedText" text-alignment="center" transparent="true"/>

      <view class="CTextLabel" origin="68, 104" size="330, 26" title="DETAILED ANALYSIS" font-color="Text" font="SectionFont" transparent="true"/><view class="CTextLabel" origin="69, 128" size="480, 16" title="Technical integrity, style context and delivery measurements" font-color="MutedText" font="SmallFont" transparent="true"/><view class="CTextButton" control-tag="UI.Back" origin="800, 116" size="143, 35" title="BACK" font-color="MutedText" font-color-highlighted="Text" frame-width="0" gradient="HardwareIdle" gradient-highlighted="HardwareActive" kick-style="true"/>

      <view class="CTextLabel" origin="124, 170" size="260, 20" title="ASSESSMENT" font-color="Accent" font="SmallFont" text-alignment="center" transparent="true"/>
      <view class="CTextLabel" origin="122, 222" size="170, 22" title="TECHNICAL QUALITY" font-color="MutedText" transparent="true"/><view class="CTextLabel" mixorator-id="technicalVerdict" origin="292, 214" size="162, 34" title="N/A" font-color="Good" font="DetailVerdictFont" text-alignment="center" transparent="true"/>
      <view class="CTextLabel" origin="122, 283" size="170, 22" title="STYLE MATCH" font-color="MutedText" transparent="true"/><view class="CTextLabel" mixorator-id="styleVerdict" origin="292, 275" size="162, 34" title="N/A" font-color="Good" font="DetailVerdictFont" text-alignment="center" transparent="true"/>
      <view class="CTextLabel" origin="122, 344" size="170, 22" title="PCM / WAV" font-color="MutedText" transparent="true"/><view class="CTextLabel" mixorator-id="pcmVerdict" origin="292, 336" size="162, 34" title="N/A" font-color="Good" font="DetailVerdictFont" text-alignment="center" transparent="true"/>
      <view class="CTextLabel" origin="122, 405" size="170, 22" title="STREAMING" font-color="MutedText" transparent="true"/><view class="CTextLabel" mixorator-id="streamingVerdict" origin="292, 397" size="162, 34" title="N/A" font-color="Good" font="DetailVerdictFont" text-alignment="center" transparent="true"/>
      <view class="CTextLabel" origin="120, 476" size="330, 18" title="ANALYSIS STATE" font-color="DimText" font="SmallFont" text-alignment="center" transparent="true"/><view class="CTextLabel" mixorator-id="stateLabel" origin="110, 497" size="350, 34" title="WAITING FOR AUDIO" font-color="Warning" font="StatusFont" text-alignment="center" transparent="true"/>

      <view class="CTextLabel" origin="618, 170" size="260, 20" title="MEASUREMENTS" font-color="Accent" font="SmallFont" text-alignment="center" transparent="true"/>
      <view class="CTextLabel" origin="600, 218" size="164, 22" title="INTEGRATED" font-color="MutedText" transparent="true"/><view class="CTextLabel" mixorator-id="integratedValue" origin="772, 210" size="160, 34" title="--" font-color="Text" font="MetricFont" text-alignment="center" transparent="true"/>
      <view class="CTextLabel" origin="600, 270" size="164, 22" title="TRUE PEAK" font-color="MutedText" transparent="true"/><view class="CTextLabel" mixorator-id="truePeakValue" origin="772, 262" size="160, 34" title="--" font-color="Text" font="MetricFont" text-alignment="center" transparent="true"/>
      <view class="CTextLabel" origin="600, 322" size="164, 22" title="PLR" font-color="MutedText" transparent="true"/><view class="CTextLabel" mixorator-id="plrValue" origin="772, 314" size="160, 34" title="--" font-color="Text" font="MetricFont" text-alignment="center" transparent="true"/>
      <view class="CTextLabel" origin="600, 374" size="164, 22" title="LRA" font-color="MutedText" transparent="true"/><view class="CTextLabel" mixorator-id="lraValue" origin="772, 366" size="160, 34" title="--" font-color="Text" font="MetricFont" text-alignment="center" transparent="true"/>
      <view class="CTextLabel" origin="600, 426" size="164, 22" title="CORRELATION" font-color="MutedText" transparent="true"/><view class="CTextLabel" mixorator-id="correlationValue" origin="772, 418" size="160, 34" title="--" font-color="Text" font="MetricFont" text-alignment="center" transparent="true"/>
      <view class="CTextLabel" origin="600, 478" size="164, 22" title="MONO" font-color="MutedText" transparent="true"/><view class="CTextLabel" mixorator-id="monoValue" origin="772, 470" size="160, 34" title="--" font-color="Text" font="MetricFont" text-alignment="center" transparent="true"/>

      <view class="CTextLabel" origin="70, 588" size="500, 20" title="Play the full programme for a definitive FINAL assessment." font-color="MutedText" transparent="true"/><view class="CTextLabel" origin="70, 612" size="500, 18" title="LIVE values are provisional and may change." font-color="DimText" font="SmallFont" transparent="true"/>
      <view class="CTextButton" control-tag="UI.Reset" origin="630, 582" size="112, 46" title="RESET" font-color="MutedText" font-color-highlighted="Text" frame-width="0" gradient="HardwareIdle" gradient-highlighted="HardwareActive" kick-style="true"/><view class="CTextButton" control-tag="UI.Analyze" origin="783, 580" size="157, 49" title="ANALYZE" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="HardwareAction" gradient-highlighted="HardwareActive" kick-style="true"/>
      <view class="CTextLabel" origin="210, 654" size="580, 16" title="Transparent assessment - audio is never altered" font-color="DimText" font="SmallFont" text-alignment="center" transparent="true"/>
    </view>
  </template>
</vstgui-ui-description>