<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <bitmaps><bitmap name="AnalysatorMainBg" path="analysator_main_bg.png"/><bitmap name="AnalysatorDetailsBg" path="analysator_details_bg.png"/></bitmaps>
  <colors>
    <color name="Background" rgba="#0B1014FF"/><color name="TopBar" rgba="#10171DFF"/><color name="Panel" rgba="#111A20F2"/><color name="PanelRaised" rgba="#17232BEE"/><color name="PanelDark" rgba="#0D151AFF"/><color name="Text" rgba="#F2F4F6FF"/><color name="MutedText" rgba="#A9B1B7FF"/><color name="DimText" rgba="#7E8A93FF"/><color name="Accent" rgba="#69D7C0FF"/><color name="AccentSoft" rgba="#173A38FF"/><color name="Good" rgba="#78D2AAFF"/><color name="Warning" rgba="#D9B66FFF"/><color name="TextShadow" rgba="#000000F0"/>
  </colors>
  <fonts>
    <font name="VerdictFont" font-name="Arial" size="24" bold="true" italic="false"/><font name="DetailVerdictFont" font-name="Arial" size="18" bold="true" italic="false"/><font name="MetricFont" font-name="Arial" size="16" bold="true" italic="false"/><font name="StatusFont" font-name="Arial" size="14" bold="true" italic="false"/><font name="SectionFont" font-name="Arial" size="15" bold="true" italic="false"/><font name="HintFont" font-name="Arial" size="11" bold="false" italic="false"/><font name="SmallFont" font-name="Arial" size="10" bold="false" italic="false"/>
  </fonts>
  <gradients>
    <gradient name="ButtonIdle"><color-stop rgba="#1B2730EE" start="0"/><color-stop rgba="#111A20EE" start="1"/></gradient><gradient name="ButtonActive"><color-stop rgba="#28524EFF" start="0"/><color-stop rgba="#173A38FF" start="1"/></gradient><gradient name="ButtonAccent"><color-stop rgba="#28524EFF" start="0"/><color-stop rgba="#173A38FF" start="1"/></gradient>
    <gradient name="HardwareIdle"><color-stop rgba="#0A1217FF" start="0"/><color-stop rgba="#050B0FFF" start="1"/></gradient><gradient name="HardwareActive"><color-stop rgba="#28756CFF" start="0"/><color-stop rgba="#0E4640FF" start="1"/></gradient><gradient name="HardwareAction"><color-stop rgba="#347F75FF" start="0"/><color-stop rgba="#15514BFF" start="1"/></gradient>
    <gradient name="HardwareClear"><color-stop rgba="#00000000" start="0"/><color-stop rgba="#00000000" start="1"/></gradient>
  </gradients>
  <control-tags>
    <control-tag name="UI.Mix" tag="10001"/><control-tag name="UI.Master" tag="10002"/><control-tag name="UI.Live" tag="10003"/><control-tag name="UI.Final" tag="10004"/><control-tag name="UI.Genre" tag="10005"/><control-tag name="UI.Era" tag="10006"/><control-tag name="UI.Reset" tag="10007"/><control-tag name="UI.Analyze" tag="10008"/><control-tag name="UI.Details" tag="10009"/><control-tag name="UI.Back" tag="10010"/>
  </control-tags>

  <template name="compactView" class="CViewContainer" origin="0, 0" size="650, 440" minSize="650, 440" maxSize="650, 440" transparent="false" background-color="Background" bitmap="AnalysatorMainBg">
    <view class="CViewContainer" mixorator-id="simplePage" origin="0, 0" size="650, 440" transparent="true">
      <view class="CTextLabel" origin="18, 10" size="190, 24" title="A N A L Y S A T O R" font-color="Text" transparent="true"/><view class="CTextLabel" origin="18, 34" size="190, 16" title="Mix &amp; Master Assessment" font-color="MutedText" font="SmallFont" transparent="true"/><view class="CTextLabel" origin="602, 14" size="30, 18" title="DE" font-color="MutedText" text-alignment="center" transparent="true"/>
      <view class="CTextLabel" mixorator-id="overallVerdict" origin="220, 116" size="210, 46" title="N/A" font-color="Good" font="VerdictFont" text-alignment="center" transparent="true"/><view class="CTextLabel" mixorator-id="overallLine1" origin="205, 170" size="240, 22" title="Choose MIX or MASTER, then ANALYZE" font-color="Text" font="HintFont" text-alignment="center" transparent="true"/><view class="CTextLabel" mixorator-id="overallLine2" origin="180, 194" size="290, 22" title="ANALYZE > PLAY FULL SONG > FINALIZE > RESULT" font-color="MutedText" font="SmallFont" text-alignment="center" transparent="true"/>
      <view class="CTextLabel" origin="18, 294" size="190, 16" title="MODE" font-color="DimText" font="SmallFont" text-alignment="center" transparent="true"/><view class="CTextButton" control-tag="UI.Mix" origin="18, 316" size="87, 35" title="MIX" text-color="Text" text-color-highlighted="Text" frame-width="0" gradient="ButtonIdle" gradient-highlighted="ButtonActive" kick-style="false"/><view class="CTextButton" control-tag="UI.Master" origin="110, 316" size="101, 35" title="MASTER" text-color="Text" text-color-highlighted="Text" frame-width="0" gradient="ButtonIdle" gradient-highlighted="ButtonActive" kick-style="false"/>
      <view class="CTextLabel" origin="420, 294" size="212, 16" title="ANALYSIS" font-color="DimText" font="SmallFont" text-alignment="center" transparent="true"/><view class="CTextButton" control-tag="UI.Live" origin="416, 316" size="116, 35" title="ANALYZE" text-color="Text" text-color-highlighted="Text" frame-width="0" gradient="ButtonIdle" gradient-highlighted="ButtonActive" kick-style="false"/><view class="CTextButton" control-tag="UI.Final" origin="536, 316" size="96, 35" title="FINALIZE" text-color="Text" text-color-highlighted="Text" frame-width="0" gradient="ButtonIdle" gradient-highlighted="ButtonActive" kick-style="false"/>
      <view class="CTextButton" control-tag="UI.Details" origin="239, 339" size="172, 40" title="DETAILS" font-color="Text" font-color-highlighted="Text" frame-width="0" gradient="ButtonAccent" gradient-highlighted="ButtonActive" kick-style="true"/>
      <view class="CTextLabel" origin="110, 397" size="68, 15" title="GENRE" font-color="DimText" font="SmallFont" text-alignment="right" transparent="true"/><view class="COptionMenu" control-tag="UI.Genre" origin="184, 394" size="142, 27" font-color="Text" back-color="PanelRaised" frame-color="AccentSoft" frame-width="1" menu-popup-style="true" text-inset="8, 0"/><view class="CTextLabel" origin="338, 397" size="44, 15" title="ERA" font-color="DimText" font="SmallFont" text-alignment="right" transparent="true"/><view class="COptionMenu" control-tag="UI.Era" origin="388, 394" size="110, 27" font-color="Text" back-color="PanelRaised" frame-color="AccentSoft" frame-width="1" menu-popup-style="true" text-inset="8, 0"/>
    </view>
  </template>

